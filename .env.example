# ============================================================
# SCAMCHECK — Configuration & Environment Variables Template
# ============================================================

# Backend Port
PORT=5001
NODE_ENV=production

# Frontend API URL (Optional, default uses relative '/api' proxy)
VITE_API_URL=

# -----------------
# Security Settings
# -----------------
JWT_SECRET=replace_with_secure_random_string_in_production
JWT_EXPIRES_IN=1h
CORS_ORIGIN=https://scamcheck.production.domain.com

# -----------------
# Database
# -----------------
# Replace with actual PostgreSQL connection URL
DATABASE_URL="postgresql://user:password@localhost:5432/scamcheck?schema=public"

# -----------------
# Services
# -----------------
ML_SERVICE_URL=http://localhost:8000

# -----------------
# Mocks & Threat Intelligence
# -----------------
# WARNING: Do NOT enable mocks in production.
ENABLE_MOCK_THREAT_INTEL=false
ENABLE_MOCK_QR_DECODER=false

# -----------------
# File Upload Limits
# -----------------
MAX_FILE_SIZE_MB=5
