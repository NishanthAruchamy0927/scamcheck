{
  "name": "scamcheck-backend",
  "version": "1.0.0",
  "description": "SCAMCHECK AI Opportunity Intelligence Engine",
  "main": "dist/server.js",
  "scripts": {
    "postinstall": "node -e \"const { spawnSync } = require('child_process'); const cmd = process.platform === 'win32' ? 'npx.cmd' : 'npx'; const result = spawnSync(cmd, ['prisma', 'generate'], { stdio: 'inherit' }); if (result.status !== 0) { console.warn('Warning: Prisma generate skipped because the local environment blocked native engine generation. You can rerun `npx prisma generate` in a less restrictive environment.'); process.exit(0); }\"",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node scripts/run-tests.mjs",
    "test:network": "node scripts/run-tests.mjs network",
    "test:db": "node scripts/run-tests.mjs db",
    "test:live": "node scripts/run-tests.mjs live",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.12.0",
    "@prisma/client": "^6.12.0",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jpeg-js": "^0.4.4",
    "jsonwebtoken": "^9.0.3",
    "jsqr": "^1.4.0",
    "mammoth": "^1.8.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.23.0",
    "pngjs": "^7.0.0",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "prisma": "^6.12.0",
    "qrcode": "^1.5.4",
    "supertest": "^7.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
