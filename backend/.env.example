# ============================================================
# SCAMCHECK — Environment Variables
# Copy to backend/.env for local development.
# ============================================================

# Backend
PORT=5001
NODE_ENV=development
# Allowed browser origin for the API (the Vite dev server by default)
FRONTEND_URL=http://localhost:5173
# Set to 1 when running behind a reverse proxy (Render, Nginx) so rate limits use real client IPs
TRUST_PROXY=

# Frontend API URL (optional; empty uses the relative '/api' path / Vite proxy)
VITE_API_URL=

# -----------------
# Security
# -----------------
# Required for login/registration. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Access token lifetime (refresh tokens last 7 days)
JWT_ACCESS_EXPIRES=15m
# Max analysis requests (investigate / compare / company-check) per IP per minute
ANALYSIS_RATE_LIMIT_PER_MIN=20

# -----------------
# Database (optional)
# -----------------
# Without it, analysis works but history, campaigns and the graph/payment APIs are disabled.
DATABASE_URL="postgresql://scamcheck:scamcheckpassword@localhost:5432/scamcheck?schema=public"

# -----------------
# ML service (optional)
# -----------------
ML_SERVICE_URL=http://localhost:8000

# -----------------
# OCR
# -----------------
OCR_TIMEOUT_MS=60000
OCR_MAX_CONCURRENCY=2

# -----------------
# Test-only mocks — never enable in production
# -----------------
ENABLE_MOCK_THREAT_INTEL=false
ENABLE_MOCK_QR_DECODER=false
